APP_NAME="Studio-Komp Serwis"
APP_ENV=production
APP_KEY=
# Nigdy nie zostawiaj true na produkcji — strona błędu pokazuje wtedy ścieżki
# serwera i pełny stack trace każdemu zalogowanemu użytkownikowi.
APP_DEBUG=false
APP_URL=https://example.com/serwis
# Uwaga: APP_URL z podkatalogiem (jak wyżej) jest poprawny na hostingu, ale
# `php artisan test` używa własnego APP_URL=http://localhost z phpunit.xml -
# bez tego klient HTTP testów dokleja podkatalog do każdej ścieżki (same 404).

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL

# Timezone used for storage (UTC) and for presentation (Europe/Warsaw).
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Europe/Warsaw

APP_MAINTENANCE_DRIVER=file

# --- Data store (decision D13 / F-57) --------------------------------------
# json  -> data lives in JSON files under storage/app/data, no database needed (default)
# mysql -> your own MySQL/MariaDB database, requires the DB_* block below
DATA_STORE=json
# Human readable JSON files (bigger, slower). Handy on a development machine.
DATA_STORE_PRETTY=false
# DATA_STORE_PATH=

# --- MySQL (only used when DATA_STORE=mysql) -------------------------------
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=serwis
# DB_USERNAME=serwis
# DB_PASSWORD=

# --- Web installer ---------------------------------------------------------
# Empty = the /__install route does not exist. Set a long random value to run
# the one-time installer on a host without SSH, then empty it again.
INSTALL_TOKEN=

# --- PWA -------------------------------------------------------------------
# Bump on every deployment, otherwise clients keep the old service worker cache.
ASSET_VERSION=1

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Szyfruj zawartość pliku sesji; Secure ustaw na true, gdy aplikacja działa po HTTPS.
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="serwis@example.com"
MAIL_FROM_NAME="${APP_NAME}"
